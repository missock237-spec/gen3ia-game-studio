# ============================================================
# GEN3IA GAME STUDIO — Configuration
# Copiez ce fichier en .env puis ajustez les valeurs.
# AUCUN secret n'est écrit en dur dans le code ; le frontend
# n'accède jamais aux variables serveur.
# ============================================================

# --- Base de données (Prisma) ---
# SQLite (défaut, développement — zéro setup) :
DATABASE_URL="file:./db/custom.db"
# Production : PostgreSQL (Neon, Supabase, RDS, Docker…) :
# DATABASE_URL="postgresql://user:password@host:5432/gen3ia?sslmode=require"

# --- Secret de hachage des tokens de session (OBLIGATOIRE en prod) ---
# Générez avec : openssl rand -base64 48
AUTH_SECRET=""

# --- Serveur multijoueur (mini-services/game-server) ---
# Port socket.io du serveur de jeu autoritaire (défaut 3003).
GAME_SERVER_PORT="3003"
# Port du mini serveur de stats HTTP (défaut 3103).
GAME_SERVER_STATS_PORT="3103"

# --- Intégration GitHub (optionnelle, serveur uniquement) ---
# Token personnel d'accès fin (scope: repo + workflow) — utilisé par
# l'orchestrateur de builds « cible github » pour dispatcher un workflow
# GitHub Actions et pousser les exports. Jamais exposé au navigateur.
GITHUB_TOKEN=""

# --- Hugging Face (optionnel, serveur uniquement) ---
# Jeton Inference Providers pour l'assistant IA / dialogues PNJ.
# Sans jeton, l'IA bascule sur z-ai-web-dev-sdk (si disponible).
HF_TOKEN=""

# --- Stockage Cloudflare R2 (optionnel — S3 compatible) ---
# Par défaut : disque local ./storage/assets (fonne parfaitement en dev).
# Renseignez les 4 variables pour activer R2 (presigned uploads navigateur→R2).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET="gen3ia-assets"

# --- Frontend ---
# URL publique affichée/partagée par l'orchestrateur de builds.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Builds cloud (cibles android / windows / linux)
# Sans ces variables, ces cibles échouent avec un message explicite
# (aucun faux build n'est produit). Les cibles web et dedicated-server
# sont toujours disponibles localement.
# ============================================================

# --- Google Cloud Build (fournisseur 1) ---
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_REGION="us-central1"
# Service account (JSON complet en base64 OU chemin de fichier) :
GOOGLE_CLOUD_CREDENTIALS=""
# GOOGLE_APPLICATION_CREDENTIALS="/chemin/sa-gen3ia.json"
GCS_BUILD_BUCKET="gen3ia-builds"

# --- GitHub Actions (fournisseur 2) ---
# Token serveur avec scopes repo + workflow. Sert aussi à l'onglet GitHub.
GITHUB_TOKEN=""

# --- Quotas & divers ---
# Quota de stockage par projet (octets, défaut 2 Go)
PROJECT_QUOTA_BYTES="2147483648"
